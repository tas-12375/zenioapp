<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#afceee">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/rounded_white_background"
        android:elevation="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:title="Add Measurement"
        app:titleTextColor="#333333"
        app:titleTextAppearance="@style/TextAppearance.AppCompat.Title"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:cardBackgroundColor="#ffebee"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_margin="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/measurement_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Measurement"
                android:textSize="24sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="16dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/value_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter value"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textColor="#333333"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/edit_text_modern"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="#f8d6d6"
                android:text="Save Measurement"
                android:textColor="#333333"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:elevation="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>